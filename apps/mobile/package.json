    "expo": "^57.0.0",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-safe-area-context": "~5.7.0"
  },
